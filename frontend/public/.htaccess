# =====================================================================
#  Apache config for the Fleet Management frontend (cPanel / public_html)
#
#  Vite copies everything in public/ into dist/, so this file is included
#  automatically every time you run "npm run build".
#
#  NOTE: files beginning with a dot are hidden. In cPanel File Manager,
#  turn on Settings > "Show Hidden Files (dotfiles)" or you will not see
#  this file after uploading and may think it failed to copy.
# =====================================================================

# --- Single Page Application routing ---------------------------------
# React Router handles /employees, /payroll/report and so on in the
# browser. Those paths do not exist as folders on the server, so without
# this rule a page refresh or a pasted link returns 404. Send anything
# that is not a real file or folder to index.html and let React Router
# resolve it. The /api exclusion matters: without it, API calls would be
# swallowed and returned as HTML instead of JSON.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never rewrite API calls -- they must reach the backend.
  RewriteCond %{REQUEST_URI} ^/api/ [OR]
  RewriteCond %{REQUEST_URI} ^/uploads/
  RewriteRule ^ - [L]

  # Serve real files and folders untouched.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else: hand to the SPA.
  RewriteRule . /index.html [L]
</IfModule>

# --- Caching ----------------------------------------------------------
# Vite fingerprints asset filenames (index-B4zx0l9E.js), so those can be
# cached hard -- a new build produces a new name. index.html must never
# be cached, or browsers keep loading the old asset names after a deploy.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compression ------------------------------------------------------
# The main JS bundle is ~2.4 MB raw but ~700 KB gzipped, so this makes a
# large difference to first load.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Basic security headers ------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
