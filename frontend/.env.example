# Frontend build-time settings.
#
# Copy to .env.production (for builds) or .env.local (for development):
#     cp .env.example .env.production
#
# IMPORTANT: Vite substitutes these values at BUILD time, not run time.
# You must run "npm run build" again after changing anything here.
# Also: anything here ends up visible in the shipped JavaScript, so never
# put a password, token or key in this file.

# --- API location ----------------------------------------------------
# LEAVE BLANK when the frontend and the API are served from the SAME
# domain. That covers:
#   - local development (vite.config.ts proxies /api to port 8000)
#   - both deployed in the same DigitalOcean app, with /api routed to
#     the backend component
#   - both behind the same nginx on a Droplet
#
# Only set this when the API is on a DIFFERENT domain from the frontend,
# for example the site on cPanel and the API on DigitalOcean. Use a full
# origin with NO trailing slash:
#
#     VITE_API_BASE_URL=https://urchin-app-3tpdf.ondigitalocean.app
#
# Cross-domain also requires the backend to permit this origin: set
# CORS_ORIGINS on the API to the frontend's address.
# VITE_API_BASE_URL=
# # VITE_API_BASE_URL=https://urchin-app-3tpdf.ondigitalocean.app
# DB_HOST=app.mangotracking.com
# DB_PORT=3306
# DB_USER=mangotracking_app
# DB_PASSWORD=Sok@$_2015
# DB_NAME=mangotracking_app_hosting
# # Fallback company used by routes that don't yet receive a company_id.
# DEFAULT_COMPANY_ID=1

# # --- Auth ------------------------------------------------------------
# # Generate a real value with:
# #   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# # Changing this later invalidates every issued token and logs all users out.
# JWT_SECRET_KEY=generate-a-long-random-string
# JWT_EXPIRE_MINUTES=480

# VITE_API_BASE_URL=https://urchin-app-3tpdf.ondigitalocean.app
VITE_API_BASE_URL