# =====================================================================
#  TEMPLATE -- safe to commit. Copy to app/.env and fill in real values:
#      cp app/.env.example app/.env
#
#  app/.env holds the real secrets and is excluded by .gitignore.
#  NEVER put a real password, token or key in THIS file -- it is
#  committed to git, and anything committed stays in the history even
#  after you delete it.
# =====================================================================

# --- MySQL -----------------------------------------------------------
# DB_HOST:
#   localhost          -> backend runs on the same machine as MySQL
#                         (local development, or deployed on cPanel)
#   <server IP address> -> backend runs elsewhere and connects remotely.
#                         Remote access also requires the connecting IP to
#                         be whitelisted under cPanel > Databases >
#                         Remote MySQL.
#DB_HOST=localhost
#DB_PORT=3306
#DB_USER=your_db_user
#DB_PASSWORD=your_db_password
#DB_NAME=your_db_name

# Fallback company used by routes that don't yet receive a company_id.
DEFAULT_COMPANY_ID=1

# --- Auth ------------------------------------------------------------
# Generate a real value with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this later invalidates every issued token and logs all users out.
JWT_SECRET_KEY=generate-a-long-random-string
JWT_EXPIRE_MINUTES=480

# --- Wialon ----------------------------------------------------------
# Live tokens are stored per company in the company_wialon_credentials
# table (Settings > Wialon Credentials), not here.
# WIALON_TOKEN=
